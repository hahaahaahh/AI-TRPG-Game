LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro
# 可选：一次配置多个 DeepSeek 模型，之后直接在游戏会话侧栏切换。
# DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_MODELS=deepseek-v4-pro,deepseek-v4-flash
# 可选：SoCLaaS 使用 https://soclaas-api.comp.nus.edu.sg/v1/chat/completions
# LLM_PROVIDER=soclaas
# SOCLAAS_API_KEY=your-soclaas-api-key-here
# SOCLAAS_BASE_URL=https://soclaas-api.comp.nus.edu.sg/v1
# SOCLAAS_MODEL=qwen3.8:27b
# SOCLAAS_MODELS=qwen3.8:27b,another-tool-capable-model
# 可选：指定模型选择器初始值；格式为 provider:model。
# LLM_DEFAULT_PROFILE=soclaas:qwen3.8:27b
# 参数由模型能力和任务类型自动决定；以下仅供旧式单模型接入兼容。
# LLM_TIMEOUT_MS=120000
# LLM_MAX_RETRIES=2
# 高级诊断覆盖：通常不需要设置。
# LLM_THINKING_TYPE=enabled
# 隐藏案件准备专用覆盖，不影响普通叙事；MAX_TOKENS是输出额度，不是输入上下文。
# 默认：SoCLaaS 16384/medium，DeepSeek 32768/low；超时均300000ms。
# SOCLAAS_SCENARIO_MAX_TOKENS=16384
# SOCLAAS_SCENARIO_REASONING_EFFORT=medium
# SOCLAAS_SCENARIO_TIMEOUT_MS=300000
# DEEPSEEK_SCENARIO_MAX_TOKENS=32768
# DEEPSEEK_SCENARIO_REASONING_EFFORT=low
# DEEPSEEK_SCENARIO_TIMEOUT_MS=300000
# 同名LLM_SCENARIO_*可作通用覆盖，提供商专用值优先。
# 官方V4.1 Flash使用 LLM_MODEL=deepseek-flash；普通叙事仍关闭思考。
